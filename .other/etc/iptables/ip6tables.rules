# Generated on 14-08-2025
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# Allow established/related traffic
-A INPUT -m state --state RELATED,ESTABLISHED -j ACCEPT

# Allow loopback interface
-A INPUT -i lo -j ACCEPT

# Allow ICMPv6 from LANs without restriction
-A INPUT -p ipv6-icmp -s fd00::/8 -j ACCEPT
-A INPUT -p ipv6-icmp -s fe80::/10 -j ACCEPT

# Allow LAN traffic (example: ULA fd00::/8 and link-local fe80::/10)
-A INPUT -s fd00::/8 -j ACCEPT
-A INPUT -s fe80::/10 -j ACCEPT

# Allow limited ICMPv6 from WAN
-A INPUT -p ipv6-icmp --icmpv6-type echo-request -m limit --limit 1/second --limit-burst 4 -j ACCEPT
-A INPUT -p ipv6-icmp --icmpv6-type destination-unreachable -j ACCEPT
-A INPUT -p ipv6-icmp --icmpv6-type time-exceeded -j ACCEPT
-A INPUT -p ipv6-icmp --icmpv6-type packet-too-big -j ACCEPT

COMMIT
