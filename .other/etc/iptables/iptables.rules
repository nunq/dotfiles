# Generated on 14-08-2025
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# Allow established/related traffic
-A INPUT -m state --state RELATED,ESTABLISHED -j ACCEPT

# Allow loopback interface
-A INPUT -i lo -j ACCEPT

# Allow ICMP from LANs without restriction
-A INPUT -p icmp -s 192.168.0.0/24 -j ACCEPT
-A INPUT -p icmp -s 192.168.178.0/24 -j ACCEPT

# Allow LAN traffic
-A INPUT -s 192.168.0.0/24 -j ACCEPT
-A INPUT -s 192.168.178.0/24 -j ACCEPT

# Allow limited ICMP from WAN
-A INPUT -p icmp --icmp-type echo-request -m limit --limit 1/second --limit-burst 4 -j ACCEPT
-A INPUT -p icmp --icmp-type destination-unreachable -j ACCEPT
-A INPUT -p icmp --icmp-type time-exceeded -j ACCEPT

COMMIT
